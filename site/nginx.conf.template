# nginx config for the wiki container. The nginx image renders this template
# into /etc/nginx/conf.d/default.conf at startup, filling in ${LIVE_DATA_REF}
# (set in the Dockerfile, overridable from docker-compose.yml).

# Small cache for the live data proxied from GitHub (see /api/ below).
proxy_cache_path /var/cache/nginx/live levels=1 keys_zone=live:1m max_size=5m inactive=7d use_temp_path=off;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Astro's static output already has a custom 404.html - use it.
    error_page 404 /404.html;

    # Hashed build assets (_astro/*) can be cached hard.
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Live data: the latest data/*.json from the GitHub repo, which the
    # sync-addon-stats workflow keeps current. Pages fetch these to update
    # addon numbers and the activity feed without a rebuild, and keep the
    # values from the last build if the fetch fails.
    location ~ ^/api/(?<live_file>addon-stats|recent-activity)\.json$ {
        # Resolve per request through Docker's DNS instead of once at startup,
        # so a DNS outage can't stop nginx from starting and changed GitHub
        # IPs are picked up.
        resolver 127.0.0.11 valid=60s ipv6=off;
        resolver_timeout 5s;
        set $live_upstream raw.githubusercontent.com;
        proxy_pass https://$live_upstream/Gasteren/irosec-homelab/${LIVE_DATA_REF}/data/$live_file.json;

        proxy_ssl_server_name on;
        proxy_ssl_name raw.githubusercontent.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_set_header Host raw.githubusercontent.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;

        # At most one request to GitHub per file per minute; if GitHub is
        # unreachable, keep serving the last good copy.
        proxy_cache live;
        proxy_cache_key "${LIVE_DATA_REF}:$live_file";
        proxy_cache_valid 200 60s;
        proxy_cache_use_stale error timeout updating http_429 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;

        # Answer with our own headers rather than GitHub's.
        proxy_hide_header Content-Type;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Vary;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-XSS-Protection;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header X-Content-Type-Options;
        add_header Content-Type "application/json; charset=utf-8" always;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Live-Cache $upstream_cache_status always;
    }

    # Everything else: short cache, since page content can change without
    # the filename changing.
    location / {
        try_files $uri $uri/index.html $uri.html =404;
        expires 5m;
        add_header Cache-Control "public, must-revalidate";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml;
}
