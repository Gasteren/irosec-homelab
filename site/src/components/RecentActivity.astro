---
interface Commit {
  message: string;
  author: string;
  date: string;
  url: string;
  sha: string;
  repo: string;
}

const REPOS = [
  'irosec-homelab',
  'TwitchDropsWatcher',
  'Adibags_Fishing',
  'BetterBags_Fishing',
  'TimeStamp',
  'RepKeeper',
  'LoZN64',
  'LevelTimeTracker',
  'HandyNotes_ValTeleports',
  'HandyNotes_NaigtalTeleports',
  'HandyNotes_Jetpacks',
  'HandyNotes_AncientShrines',
  'Hall-Of-Fallen-Heroes',
  'AntiSocial',
  'Interrupted',
  'InterruptBar',
  'AfkDelight',
  'FishKeeper',
];

const VISIBLE_COUNT = 6;
const TOTAL_COUNT = 20;

let commits: Commit[] = [];

try {
  const results = await Promise.all(
    REPOS.map(async (repo) => {
      try {
        const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
        if (process.env.GITHUB_TOKEN) {
          headers['Authorization'] = `Bearer ${process.env.GITHUB_TOKEN}`;
        }
        const res = await fetch(
          `https://api.github.com/repos/Gasteren/${repo}/commits?per_page=100`,
          { headers }
        );
        if (!res.ok) return [];
        const data = await res.json();
        if (!Array.isArray(data)) return [];
        return data.map((c: any) => ({ ...c, __repo: repo }));
      } catch {
        return [];
      }
    })
  );

  const all = results.flat();

  commits = all
    .filter((c: any) => {
      const login = c.author?.login || '';
      const authorName = c.commit?.author?.name || '';
      return !login.includes('[bot]') && !authorName.includes('[bot]');
    })
    .map((c: any) => ({
      message: (c.commit?.message || '').split('\n')[0].slice(0, 60),
      author: 'Gasteren',
      date: c.commit?.author?.date || c.commit?.committer?.date,
      url: c.html_url,
      sha: (c.sha || '').slice(0, 7),
      repo: c.__repo,
    }))
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .slice(0, TOTAL_COUNT);
} catch {
  commits = [];
}

function timeAgo(iso: string) {
  const diffMs = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diffMs / 60000);
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}
---

{commits.length > 0 && (
  <div class="recent-activity">
    <h3>Recent activity</h3>
    <div class="feed">
      {commits.map((c, i) => (
        <a
          class="entry"
          data-index={i}
          style={i >= VISIBLE_COUNT ? 'display: none;' : undefined}
          href={c.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="repo-badge">{c.repo}</span>
          <span class="sep">|</span>
          <span class="msg">{c.message}</span>
          <span class="sep">|</span>
          <span class="author">{c.author}</span>
          <span class="time" data-date={c.date}>--</span>
        </a>
      ))}
    </div>
    {commits.length > VISIBLE_COUNT && (
      <button id="show-all-commits" type="button">
        Show all ({commits.length})
      </button>
    )}
  </div>
)}

<style>
  .recent-activity {
    margin-top: 2.5rem;
    max-width: 720px;
  }
  .recent-activity h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
  .feed {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    border-radius: 8px;
    overflow: hidden;
  }
  .entry {
    display: grid;
    grid-template-columns: 180px 16px 1fr 16px 90px 55px;
    align-items: center;
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    color: var(--sl-color-white);
    border-bottom: 1px solid var(--sl-color-hairline, var(--sl-color-gray-6));
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
  }
  .entry:last-child {
    border-bottom: none;
  }
  .entry:hover {
    background: var(--sl-color-accent-low);
  }
  .repo-badge {
    display: inline-block;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
    font-size: 0.9em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: fit-content;
    max-width: 100%;
  }
  .sep {
    opacity: 0.35;
    text-align: center;
  }
  .msg {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .author {
    opacity: 0.6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .time {
    opacity: 0.45;
    font-size: 0.85em;
    text-align: right;
  }
  #show-all-commits {
    margin-top: 0.75rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    border-radius: 6px;
    background: transparent;
    color: var(--sl-color-white);
    font-size: 0.8rem;
    cursor: pointer;
  }
  #show-all-commits:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }
</style>

<script>
  const btn = document.getElementById('show-all-commits');
  if (btn) {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.entry[style*="display: none"]').forEach((el) => {
        el.style.display = '';
      });
      btn.remove();
    });
  }

  function timeAgo(iso) {
    const diffMs = Date.now() - new Date(iso).getTime();
    const mins = Math.floor(diffMs / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    const hours = Math.floor(mins / 60);
    if (hours < 24) return hours + 'h ago';
    const days = Math.floor(hours / 24);
    return days + 'd ago';
  }

  function refreshTimes() {
    document.querySelectorAll('.time[data-date]').forEach((el) => {
      el.textContent = timeAgo(el.getAttribute('data-date'));
    });
  }

  refreshTimes();
  setInterval(refreshTimes, 30000);
</script>
