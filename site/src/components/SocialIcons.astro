<div class="social-icons">
  {links.map((l) => (
    <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.label} set:html={l.icon} />
  ))}
</div>

<style>
  .social-icons {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .social-icons a {
    color: var(--sl-color-text);
    display: inline-flex;
  }
  .social-icons a:hover {
    color: var(--sl-color-accent-high);
  }
  .social-icons svg {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
